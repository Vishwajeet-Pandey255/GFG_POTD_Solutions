class Solution {
    int minEdgesReq(int n, int[][] edges) {
        int m = edges.length;

        // A connected graph with n vertices needs at least n - 1 edges.
        if (m < n - 1) {
            return -1;
        }

        DSU dsu = new DSU(n);

        // Connect all possible vertices using existing edges.
        for (int[] edge : edges) {
            dsu.union(edge[0], edge[1]);
        }

        // Count connected components.
        int components = 0;

        for (int i = 0; i < n; i++) {
            if (dsu.find(i) == i) {
                components++;
            }
        }

        // To connect 'components' components,
        // we need exactly components - 1 edge movements.
        return components - 1;
    }

    // Disjoint Set Union
    class DSU {
        int[] parent;
        int[] size;

        DSU(int n) {
            parent = new int[n];
            size = new int[n];

            for (int i = 0; i < n; i++) {
                parent[i] = i;
                size[i] = 1;
            }
        }

        int find(int x) {
            if (parent[x] != x) {
                parent[x] = find(parent[x]);
            }

            return parent[x];
        }

        void union(int a, int b) {
            int parentA = find(a);
            int parentB = find(b);

            if (parentA == parentB) {
                return;
            }

            // Union by size
            if (size[parentA] < size[parentB]) {
                int temp = parentA;
                parentA = parentB;
                parentB = temp;
            }

            parent[parentB] = parentA;
            size[parentA] += size[parentB];
        }
    }
}
