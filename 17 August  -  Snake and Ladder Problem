class Solution {
    public int minThrows(int n, int[] lad, int[] sn) {
        int total = n * n;

        // jump[i] = destination if there is a snake/ladder at cell i
        int[] jump = new int[total + 1];

        for (int i = 0; i < lad.length; i += 2) {
            jump[lad[i]] = lad[i + 1];
        }

        for (int i = 0; i < sn.length; i += 2) {
            jump[sn[i]] = sn[i + 1];
        }

        // BFS because every dice throw has equal cost (1)
        boolean[] visited = new boolean[total + 1];
        int[] queue = new int[total + 1];
        int[] distance = new int[total + 1];

        int front = 0, rear = 0;

        queue[rear++] = 1;
        visited[1] = true;

        while (front < rear) {
            int current = queue[front++];

            if (current == total) {
                return distance[current];
            }

            // Try all possible dice throws: 1 to 6
            for (int dice = 1; dice <= 6; dice++) {
                int next = current + dice;

                if (next > total) {
                    break;
                }

                // Take snake/ladder immediately
                if (jump[next] != 0) {
                    next = jump[next];
                }

                if (!visited[next]) {
                    visited[next] = true;
                    distance[next] = distance[current] + 1;
                    queue[rear++] = next;
                }
            }
        }

        return -1;
    }
}
