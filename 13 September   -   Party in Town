class Solution {
    public int partyHouse(ArrayList<ArrayList<Integer>> adj) {
        int n = adj.size();

        // Find one endpoint of the diameter
        int farthest = bfs(1, adj)[0];

        // Find the other endpoint and the diameter length
        int diameter = bfs(farthest, adj)[1];

        // Minimum eccentricity = ceil(diameter / 2)
        return (diameter + 1) / 2;
    }

    private int[] bfs(int start, ArrayList<ArrayList<Integer>> adj) {
        int n = adj.size();

        int[] dist = new int[n + 1];
        Arrays.fill(dist, -1);

        Queue<Integer> queue = new LinkedList<>();
        queue.offer(start);
        dist[start] = 0;

        int farthestNode = start;

        while (!queue.isEmpty()) {
            int node = queue.poll();

            if (dist[node] > dist[farthestNode]) {
                farthestNode = node;
            }

            for (int next : adj.get(node - 1)) {
                if (dist[next] == -1) {
                    dist[next] = dist[node] + 1;
                    queue.offer(next);
                }
            }
        }

        return new int[]{farthestNode, dist[farthestNode]};
    }
}
