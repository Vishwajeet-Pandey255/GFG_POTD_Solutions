class Solution {
    private int maxSum;

    public int maxPathSum(Node root) {
        if (root == null) {
            return -1;
        }

        maxSum = Integer.MIN_VALUE;
        maxPathFromNode(root);

        // If fewer than two leaf nodes exist
        if (leafCount(root) < 2) {
            return -1;
        }

        return maxSum;
    }

    private int maxPathFromNode(Node node) {
        if (node == null) {
            return Integer.MIN_VALUE;
        }

        // Leaf node
        if (node.left == null && node.right == null) {
            return node.data;
        }

        int left = maxPathFromNode(node.left);
        int right = maxPathFromNode(node.right);

        // A path between two leaves can pass through this node
        if (node.left != null && node.right != null) {
            maxSum = Math.max(maxSum, left + node.data + right);
            return node.data + Math.max(left, right);
        }

        // Only one child exists
        if (node.left != null) {
            return node.data + left;
        }

        return node.data + right;
    }

    private int leafCount(Node node) {
        if (node == null) {
            return 0;
        }

        if (node.left == null && node.right == null) {
            return 1;
        }

        return leafCount(node.left) + leafCount(node.right);
    }
}
