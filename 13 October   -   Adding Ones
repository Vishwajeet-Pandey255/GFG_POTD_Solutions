class Solution {
    public ArrayList<Integer> update(int n, int[] updates) {
        ArrayList<Integer> arr = new ArrayList<>();
        int[] freq = new int[n + 1];

        for (int j : updates) {
            freq[j - 1]++;
        }

        int count = 0;
        for (int i = 0; i < n; i++) {
            count += freq[i];
            arr.add(count);
        }

        return arr;
    }
}
