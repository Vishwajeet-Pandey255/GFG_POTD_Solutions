class Solution {
    public int maxHeight(int[] height, int[] width, int[] length) {
        int n = height.length;

        int[][] box = new int[3 * n][3];

        int k = 0;

        for (int i = 0; i < n; i++) {
            int h = height[i];
            int w = width[i];
            int l = length[i];

            box[k++] = new int[] {
                h, Math.max(w, l), Math.min(w, l)
            };

            box[k++] = new int[] {
                w, Math.max(h, l), Math.min(h, l)
            };

            box[k++] = new int[] {
                l, Math.max(h, w), Math.min(h, w)
            };
        }

        int m = box.length;
        int[] dp = new int[m];

        int ans = 0;

        for (int i = 0; i < m; i++) {
            ans = Math.max(ans, solve(box, i, dp));
        }

        return ans;
    }

    private int solve(int[][] box, int i, int[] dp) {
        if (dp[i] != 0) {
            return dp[i];
        }

        int best = 0;

        for (int j = 0; j < box.length; j++) {
            if (box[j][1] < box[i][1] &&
                box[j][2] < box[i][2]) {

                best = Math.max(best, solve(box, j, dp));
            }
        }

        dp[i] = box[i][0] + best;

        return dp[i];
    }
}
