class Solution {
    public ArrayList<Integer> maximumWeight(int n, int[][] edges, int[] queries) {

        ArrayList<Integer> ans = new ArrayList<>();

        // Sort edges by weight
        Arrays.sort(edges, (a, b) -> Integer.compare(a[2], b[2]));

        // Store queries with their original indices
        int q = queries.length;
        int[][] queryArr = new int[q][2];

        for (int i = 0; i < q; i++) {
            queryArr[i][0] = queries[i];
            queryArr[i][1] = i;
        }

        Arrays.sort(queryArr, (a, b) ->
            Integer.compare(a[0], b[0])
        );

        int[] parent = new int[n + 1];
        int[] size = new int[n + 1];

        for (int i = 1; i <= n; i++) {
            parent[i] = i;
            size[i] = 1;
        }

        long[] result = new long[q];

        int edgeIndex = 0;
        long paths = 0;

        for (int i = 0; i < q; i++) {

            int limit = queryArr[i][0];
            int originalIndex = queryArr[i][1];

            // Process all edges with weight <= limit
            while (edgeIndex < edges.length &&
                   edges[edgeIndex][2] <= limit) {

                int u = edges[edgeIndex][0];
                int v = edges[edgeIndex][1];

                int rootU = find(parent, u);
                int rootV = find(parent, v);

                if (rootU != rootV) {

                    // Newly formed paths
                    paths += (long) size[rootU] * size[rootV];

                    // Union by size
                    if (size[rootU] < size[rootV]) {
                        int temp = rootU;
                        rootU = rootV;
                        rootV = temp;
                    }

                    parent[rootV] = rootU;
                    size[rootU] += size[rootV];
                }

                edgeIndex++;
            }

            result[originalIndex] = paths;
        }

        // Restore original query order
        for (int i = 0; i < q; i++) {
            ans.add((int) result[i]);
        }

        return ans;
    }

    // Find with path compression
    private int find(int[] parent, int x) {

        if (parent[x] != x) {
            parent[x] = find(parent, parent[x]);
        }

        return parent[x];
    }
}
