
class Solution {
    public int maxPackages(int[] arr, int totalTime) {
        int n = arr.length;

        int sum = 0;

        // If totalTime >= array length, take all packages
        if (totalTime >= n) {
            for (int x : arr) {
                sum += x;
            }
            return sum;
        }

        // Calculate first window sum
        for (int i = 0; i < totalTime; i++) {
            sum += arr[i];
        }

        int maxSum = sum;

        // Sliding window
        for (int i = totalTime; i < n; i++) {
            sum += arr[i] - arr[i - totalTime];
            maxSum = Math.max(maxSum, sum);
        }

        return maxSum;
    }
}
