class Solution {
    public int findMinCost(String s1, String s2, int costS1, int costS2) {
        int n = s1.length();
        int m = s2.length();

        // dp[i][j] = minimum cost to make s1[0..i-1] and s2[0..j-1] identical
        int[][] dp = new int[n + 1][m + 1];

        // Delete all characters from s1
        for (int i = 1; i <= n; i++) {
            dp[i][0] = i * costS1;
        }

        // Delete all characters from s2
        for (int j = 1; j <= m; j++) {
            dp[0][j] = j * costS2;
        }

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {

                if (s1.charAt(i - 1) == s2.charAt(j - 1)) {
                    // Keep this character in both strings
                    dp[i][j] = dp[i - 1][j - 1];
                } else {
                    // Delete from s1 OR delete from s2
                    dp[i][j] = Math.min(
                        dp[i - 1][j] + costS1,
                        dp[i][j - 1] + costS2
                    );
                }
            }
        }

        return dp[n][m];
    }
}
