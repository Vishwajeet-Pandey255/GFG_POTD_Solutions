class Solution {
    class Fenwick {
        int[] bit;
        int n;

        Fenwick(int n) {
            this.n = n;
            bit = new int[n + 2];
        }

        void update(int idx, int val) {
            while (idx <= n) {
                bit[idx] += val;
                idx += idx & -idx;
            }
        }

        int query(int idx) {
            int sum = 0;
            while (idx > 0) {
                sum += bit[idx];
                idx -= idx & -idx;
            }
            return sum;
        }
    }

    public int countSubstring(String s) {
        int n = s.length();

        int[] prefix = new int[n + 1];
        for (int i = 1; i <= n; i++) {
            prefix[i] = prefix[i - 1] + (s.charAt(i - 1) == '1' ? 1 : -1);
        }

        int[] all = prefix.clone();
        java.util.Arrays.sort(all);

        java.util.HashMap<Integer, Integer> map = new java.util.HashMap<>();
        int rank = 1;
        for (int x : all) {
            if (!map.containsKey(x)) {
                map.put(x, rank++);
            }
        }

        Fenwick ft = new Fenwick(rank);
        long ans = 0;

        for (int x : prefix) {
            int idx = map.get(x);
            ans += ft.query(idx - 1);
            ft.update(idx, 1);
        }

        return (int) ans;
    }
}
