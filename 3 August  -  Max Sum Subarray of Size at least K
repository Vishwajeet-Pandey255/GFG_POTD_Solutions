class Solution {
    public int maxSumWithK(int[] arr, int k) {
        int n = arr.length;

        // maxSum[i] = maximum subarray sum ending at i
        int[] maxSum = new int[n];
        maxSum[0] = arr[0];

        for (int i = 1; i < n; i++) {
            maxSum[i] = Math.max(arr[i], maxSum[i - 1] + arr[i]);
        }

        // Sum of first k elements
        int sum = 0;
        for (int i = 0; i < k; i++) {
            sum += arr[i];
        }

        int ans = sum;

        for (int i = k; i < n; i++) {
            sum += arr[i] - arr[i - k];

            // Subarray of exactly k elements
            ans = Math.max(ans, sum);

            // Extend with best prefix ending before current window
            ans = Math.max(ans, sum + maxSum[i - k]);
        }

        return ans;
    }
}
