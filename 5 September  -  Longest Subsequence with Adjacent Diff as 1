class Solution {
    public int longestSubseq(int[] arr) {
        int[] dp = new int[1000002];
        int ans = 0;

        for (int num : arr) {
            int prev = 0;

            if (num > 0) {
                prev = Math.max(prev, dp[num - 1]);
            }

            if (num < 1000001) {
                prev = Math.max(prev, dp[num + 1]);
            }

            dp[num] = Math.max(dp[num], prev + 1);
            ans = Math.max(ans, dp[num]);
        }

        return ans;
    }
}
