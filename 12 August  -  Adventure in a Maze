class Solution {

    public ArrayList<Integer> findWays(int[][] grid) {
        int n = grid.length;
        int MOD = 1000000007;

        long[][] ways = new long[n][n];
        int[][] adventure = new int[n][n];

        ways[0][0] = 1;
        adventure[0][0] = grid[0][0];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (i == 0 && j == 0) {
                    continue;
                }

                // From the cell above
                if (i > 0 &&
                    (grid[i - 1][j] == 2 || grid[i - 1][j] == 3) &&
                    ways[i - 1][j] > 0) {

                    ways[i][j] = (ways[i][j] + ways[i - 1][j]) % MOD;

                    adventure[i][j] = Math.max(
                        adventure[i][j],
                        adventure[i - 1][j] + grid[i][j]
                    );
                }

                // From the cell on the left
                if (j > 0 &&
                    (grid[i][j - 1] == 1 || grid[i][j - 1] == 3) &&
                    ways[i][j - 1] > 0) {

                    ways[i][j] = (ways[i][j] + ways[i][j - 1]) % MOD;

                    adventure[i][j] = Math.max(
                        adventure[i][j],
                        adventure[i][j - 1] + grid[i][j]
                    );
                }
            }
        }

        ArrayList<Integer> result = new ArrayList<>();
        result.add((int) ways[n - 1][n - 1]);

        // If there is no valid path, maximum adventure is 0
        if (ways[n - 1][n - 1] == 0) {
            result.add(0);
        } else {
            result.add(adventure[n - 1][n - 1]);
        }

        return result;
    }
}
