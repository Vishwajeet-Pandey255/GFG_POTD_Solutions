class Solution {
    public int maxSubsetXOR(int[] arr) {
        int n = arr.length;
        int index = 0;

        // Traverse from the most significant bit to the least significant bit
        for (int bit = 31; bit >= 0; bit--) {

            int maxIndex = -1;

            // Find an element with the current bit set
            for (int i = index; i < n; i++) {
                if (((arr[i] >> bit) & 1) == 1) {
                    maxIndex = i;
                    break;
                }
            }

            if (maxIndex == -1)
                continue;

            // Swap
            int temp = arr[index];
            arr[index] = arr[maxIndex];
            arr[maxIndex] = temp;

            // Eliminate the current bit from all other elements
            for (int i = 0; i < n; i++) {
                if (i != index && ((arr[i] >> bit) & 1) == 1) {
                    arr[i] ^= arr[index];
                }
            }

            index++;
        }

        // Compute maximum XOR from the basis
        int ans = 0;
        for (int num : arr) {
            ans = Math.max(ans, ans ^ num);
        }

        return ans;
    }
}
