class Solution {
    public int subarrayXor(int[] arr) {
        int n = arr.length;

        // If array length is even, every element contributes
        // an even number of times, so the result is 0.
        if (n % 2 == 0) {
            return 0;
        }

        // If array length is odd, only elements at even
        // indices (0-based) contribute to the final XOR.
        int ans = 0;

        for (int i = 0; i < n; i += 2) {
            ans ^= arr[i];
        }

        return ans;
    }
}
