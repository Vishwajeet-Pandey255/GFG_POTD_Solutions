/* Structure of Binary Tree Node
class Node {
    int data;
    Node left, right;

    Node(int val) {
        data = val;
        left = right = null;
    }
} */

import java.util.*;

class Solution {
    private int preIndex;
    private HashMap<Integer, Integer> pos;

    public Node constructBinaryTree(int[] pre, int[] preMirror) {
        preIndex = 0;
        pos = new HashMap<>();

        for (int i = 0; i < preMirror.length; i++) {
            pos.put(preMirror[i], i);
        }

        return build(pre, 0, preMirror.length - 1);
    }

    private Node build(int[] pre, int l, int r) {
        if (preIndex >= pre.length || l > r)
            return null;

        Node root = new Node(pre[preIndex++]);

        // Leaf node
        if (l == r || preIndex >= pre.length)
            return root;

        int idx = pos.get(pre[preIndex]);

        // Build left subtree first
        root.left = build(pre, idx, r);

        // Build right subtree
        root.right = build(pre, l + 1, idx - 1);

        return root;
    }
}
