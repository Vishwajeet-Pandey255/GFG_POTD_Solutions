class Solution {
    public ArrayList<Integer> getMarks(int[] l, int[] r, int[] rank) {
        int n = l.length;

        // prefix[i] = total number of valid marks from interval 0 to i
        long[] prefix = new long[n];

        for (int i = 0; i < n; i++) {
            long length = (long) r[i] - l[i] + 1;
            prefix[i] = length + (i > 0 ? prefix[i - 1] : 0);
        }

        ArrayList<Integer> result = new ArrayList<>();

        for (int k : rank) {
            // Find the first interval whose cumulative count >= k
            int low = 0, high = n - 1;

            while (low < high) {
                int mid = low + (high - low) / 2;

                if (prefix[mid] >= k) {
                    high = mid;
                } else {
                    low = mid + 1;
                }
            }

            int interval = low;

            // Number of marks before this interval
            long previousCount = interval == 0 ? 0 : prefix[interval - 1];

            // Position inside the current interval (0-based)
            long offset = k - previousCount - 1;

            result.add((int) (l[interval] + offset));
        }

        return result;
    }
}
