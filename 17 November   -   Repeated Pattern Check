class Solution {
    public boolean findPattern(String s) {
        int i = 0;
        int n = s.length();

        while (i < n) {
            // Count consecutive 'x'
            int xCount = 0;
            while (i < n && s.charAt(i) == 'x') {
                xCount++;
                i++;
            }

            // Every group must start with at least one 'x'
            if (xCount == 0) {
                return false;
            }

            // Count consecutive 'y'
            int yCount = 0;
            while (i < n && s.charAt(i) == 'y') {
                yCount++;
                i++;
            }

            // Number of x's and y's must be equal
            if (xCount != yCount) {
                return false;
            }
        }

        return true;
    }
}
