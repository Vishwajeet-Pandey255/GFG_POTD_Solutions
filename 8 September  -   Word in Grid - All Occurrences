class Solution {
    public ArrayList<ArrayList<Integer>> searchWord(char[][] mat, String word) {
        ArrayList<ArrayList<Integer>> ans = new ArrayList<>();

        int n = mat.length;
        int m = mat[0].length;

        // 8 possible straight-line directions
        int[] dx = {-1, -1, -1, 0, 0, 1, 1, 1};
        int[] dy = {-1,  0,  1, -1, 1, -1, 0, 1};

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                // Starting character must match
                if (mat[i][j] != word.charAt(0)) {
                    continue;
                }

                boolean found = false;

                // Check word in all 8 directions
                for (int d = 0; d < 8 && !found; d++) {
                    int x = i;
                    int y = j;
                    int k;

                    for (k = 1; k < word.length(); k++) {
                        x += dx[d];
                        y += dy[d];

                        if (x < 0 || x >= n || y < 0 || y >= m ||
                            mat[x][y] != word.charAt(k)) {
                            break;
                        }
                    }

                    if (k == word.length()) {
                        found = true;
                    }
                }

                // Add starting position only once
                if (found) {
                    ArrayList<Integer> pos = new ArrayList<>();
                    pos.add(i);
                    pos.add(j);
                    ans.add(pos);
                }
            }
        }

        return ans;
    }
}
