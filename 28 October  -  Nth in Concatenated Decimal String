class Solution {
    public char nthCharacter(int n) {
        long count = 9;
        long length = 1;
        long start = 1;

        while (n > count * length) {
            n -= count * length;
            length++;
            count *= 10;
            start *= 10;
        }

        long number = start + (n - 1) / length;
        int index = (int) ((n - 1) % length);

        return Long.toString(number).charAt(index);
    }
}
