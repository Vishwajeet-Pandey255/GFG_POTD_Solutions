class Solution {
    public int maxTask(int[] h, int[] l) {
        int n = h.length;

        int[] dp = new int[n + 1];

        // Day 0
        dp[0] = 0;

        // First day: either low-effort, high-effort, or no task
        dp[1] = Math.max(h[0], l[0]);

        for (int i = 2; i <= n; i++) {
            // Perform low-effort task on day i-1
            int low = dp[i - 1] + l[i - 1];

            // Perform high-effort task on day i-1.
            // Previous day must have no task.
            int high = dp[i - 2] + h[i - 1];

            // Or perform no task
            dp[i] = Math.max(dp[i - 1], Math.max(low, high));
        }

        return dp[n];
    }
}
