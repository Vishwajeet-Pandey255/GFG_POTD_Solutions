class Solution {
    public String findRollOut(String s, int[] roll) {
        int n = s.length();
        int[] freq = new int[n];

        for (int r : roll) {
            freq[r - 1]++;
        }

        char[] arr = s.toCharArray();
        int shifts = 0;

        for (int i = n - 1; i >= 0; i--) {
            shifts = (shifts + freq[i]) % 26;
            arr[i] = (char) ('a' + (arr[i] - 'a' + shifts) % 26);
        }

        return new String(arr);
    }
}
