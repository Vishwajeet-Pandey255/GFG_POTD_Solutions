class Solution {
    public int maxIndexDifference(String s) {
        int n = s.length();
        int[] bestReachChar = new int[26];
        
        for (int i = 0; i < 26; i++) {
            bestReachChar[i] = -1;
        }

        int ans = -1;

        for (int i = n - 1; i >= 0; i--) {
            int ch = s.charAt(i) - 'a';
            int reach = i;

            if (ch < 25 && bestReachChar[ch + 1] != -1) {
                reach = bestReachChar[ch + 1];
            }

            if (reach > bestReachChar[ch]) {
                bestReachChar[ch] = reach;
            }

            if (ch == 0) {
                ans = Math.max(ans, reach - i);
            }
        }

        return ans;
    }
}
