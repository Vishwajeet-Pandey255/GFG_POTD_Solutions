import java.util.*;

class Solution {
    public int largestArea(int n, int m, int k, int[][] arr) {
        if (k == 0) return n * m;

        int[] rows = new int[k];
        int[] cols = new int[k];

        for (int i = 0; i < k; i++) {
            rows[i] = arr[i][0];
            cols[i] = arr[i][1];
        }

        Arrays.sort(rows);
        Arrays.sort(cols);

        int maxRows = maxGap(rows, n);
        int maxCols = maxGap(cols, m);

        return maxRows * maxCols;
    }

    private int maxGap(int[] a, int limit) {
        int prev = 0;
        int max = 0;

        for (int x : a) {
            max = Math.max(max, x - prev - 1);
            prev = x;
        }

        max = Math.max(max, limit - prev);
        return max;
    }
}
