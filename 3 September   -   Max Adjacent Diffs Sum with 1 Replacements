class Solution {
    public int maxDiffSum(int[] arr) {
        int n = arr.length;

        if (n <= 1) {
            return 0;
        }

        // dpOriginal = maximum sum ending with arr[i]
        // dpOne = maximum sum ending with 1
        long dpOriginal = 0;
        long dpOne = 0;

        for (int i = 1; i < n; i++) {
            long newOriginal = Math.max(
                dpOriginal + Math.abs((long) arr[i] - arr[i - 1]),
                dpOne + Math.abs((long) arr[i] - 1)
            );

            long newOne = Math.max(
                dpOriginal + Math.abs((long) arr[i - 1] - 1),
                dpOne
            );

            dpOriginal = newOriginal;
            dpOne = newOne;
        }

        return (int) Math.max(dpOriginal, dpOne);
    }
}
