class Solution {
    public String compress(String s) {
        int n = s.length();

        // KMP prefix-function (LPS array)
        int[] lps = new int[n];

        for (int i = 1; i < n; i++) {
            int j = lps[i - 1];

            while (j > 0 && s.charAt(i) != s.charAt(j)) {
                j = lps[j - 1];
            }

            if (s.charAt(i) == s.charAt(j)) {
                j++;
            }

            lps[i] = j;
        }

        StringBuilder ans = new StringBuilder();

        // Construct answer from right to left
        int i = n - 1;

        while (i >= 0) {
            /*
             * A '*' can replace a prefix when the current string
             * consists of two equal parts.
             *
             * For a prefix of length len:
             *   len must be even
             *   the prefix must have a period <= len/2
             */
            if (i % 2 == 1) {
                int len = i + 1;
                int longestPrefixSuffix = lps[i];

                int period = len - longestPrefixSuffix;

                if (longestPrefixSuffix >= len / 2
                        && len % (2 * period) == 0) {

                    ans.append('*');

                    // Keep the first half because the second half
                    // can be generated by '*'.
                    i = len / 2 - 1;
                    continue;
                }
            }

            ans.append(s.charAt(i));
            i--;
        }

        return ans.reverse().toString();
    }
}
