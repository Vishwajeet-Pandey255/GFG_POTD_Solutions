class Solution {
    public int maxFruits(ArrayList<Integer> arr, int m) {
        int n = arr.size();

        long windowSum = 0;

        // Sum of first m trees
        for (int i = 0; i < m; i++) {
            windowSum += arr.get(i);
        }

        long maxSum = windowSum;

        // Check all remaining circular windows
        for (int i = 1; i < n; i++) {
            // Remove the tree leaving the window
            windowSum -= arr.get(i - 1);

            // Add the new tree, wrapping around using %
            windowSum += arr.get((i + m - 1) % n);

            maxSum = Math.max(maxSum, windowSum);
        }

        return (int) maxSum;
    }
}
