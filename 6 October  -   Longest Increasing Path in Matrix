class Solution {
    public int longIncPath(int[][] matrix, int n, int m) {
        int[][] dp = new int[n][m];
        int ans = 0;

        // Process cells in increasing order of their values
        int[][] cells = new int[n * m][3];
        int k = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                cells[k][0] = matrix[i][j];
                cells[k][1] = i;
                cells[k][2] = j;
                k++;
            }
        }

        // Sort cells by their values
        java.util.Arrays.sort(cells, (a, b) -> Integer.compare(a[0], b[0]));

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        for (int[] cell : cells) {
            int value = cell[0];
            int r = cell[1];
            int c = cell[2];

            dp[r][c] = 1;

            for (int d = 0; d < 4; d++) {
                int nr = r + dr[d];
                int nc = c + dc[d];

                if (nr >= 0 && nr < n && nc >= 0 && nc < m
                        && matrix[nr][nc] < value) {
                    dp[r][c] = Math.max(dp[r][c], dp[nr][nc] + 1);
                }
            }

            ans = Math.max(ans, dp[r][c]);
        }

        return ans;
    }
}
