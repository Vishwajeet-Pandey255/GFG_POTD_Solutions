
/*
Structure of a Binary Search Tree node
class Node {
    int data;
    Node left, right;

    public Node(int val) {
        data = val;
        left = right = null;
    }
}
*/

class Solution {
    public int minDiff(Node root, int k) {

        int min = Integer.MAX_VALUE;

        while (root != null) {

            min = Math.min(min, Math.abs(root.data - k));

            // Exact match found
            if (min == 0) {
                return 0;
            }

            // Move left if k is smaller
            if (k < root.data) {
                root = root.left;
            }
            // Move right if k is greater
            else {
                root = root.right;
            }
        }

        return min;
    }
}
