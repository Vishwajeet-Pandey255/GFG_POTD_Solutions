class Solution {
    public int minCost(int n, int i, int d, int c) {
        int[] dp = new int[n + 1];

        dp[0] = 0;

        for (int len = 1; len <= n; len++) {

            // Option 1: Insert one character
            dp[len] = dp[len - 1] + i;

            // Option 2: If len is even, reach it by copy-paste
            if (len % 2 == 0) {
                dp[len] = Math.min(dp[len],
                        dp[len / 2] + c);
            }

            // Option 3: If len is odd, copy-paste to len + 1
            // and delete one character
            else {
                dp[len] = Math.min(dp[len],
                        dp[(len + 1) / 2] + c + d);
            }
        }

        return dp[n];
    }
}
