class Solution {
    public int findMax(int n) {
        int answer = n;
        int maxSum = digitSum(n);

        int place = 1;
        int temp = n;

        while (temp > 0) {
            int candidate = (n / (place * 10)) * (place * 10)
                            + ((n / place) % 10 - 1) * place
                            + (place - 1);

            if ((n / place) % 10 > 0 && candidate >= 1) {
                int sum = digitSum(candidate);

                // Update if digit sum is greater,
                // or same but candidate is larger
                if (sum > maxSum || (sum == maxSum && candidate > answer)) {
                    maxSum = sum;
                    answer = candidate;
                }
            }

            temp /= 10;
            place *= 10;
        }

        return answer;
    }

    private int digitSum(int n) {
        int sum = 0;

        while (n > 0) {
            sum += n % 10;
            n /= 10;
        }

        return sum;
    }
}
