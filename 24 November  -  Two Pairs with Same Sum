class Solution {
    public ArrayList<Integer> findPairs(int[] arr) {
        int n = arr.length;

        HashMap<Integer, ArrayList<Integer>> map = new HashMap<>();

        // Store all pairs grouped by their sum
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int sum = arr[i] + arr[j];

                map.computeIfAbsent(sum, k -> new ArrayList<>())
                   .add(i * n + j);
            }
        }

        // Check pairs in lexicographical order
        for (int a = 0; a < n; a++) {
            for (int b = a + 1; b < n; b++) {

                int sum = arr[a] + arr[b];

                ArrayList<Integer> pairs = map.get(sum);

                for (int encoded : pairs) {
                    int c = encoded / n;
                    int d = encoded % n;

                    if (c < a || (c == a && d <= b)) {
                        continue;
                    }

                    if (a != c && a != d &&
                        b != c && b != d) {

                        return new ArrayList<>(
                            Arrays.asList(a, b, c, d)
                        );
                    }
                }
            }
        }

        return new ArrayList<>(
            Arrays.asList(-1, -1, -1, -1)
        );
    }
}
