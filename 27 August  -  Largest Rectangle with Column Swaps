class Solution {
    public int maxArea(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;

        // height[j] = consecutive number of 1s ending at current row
        int[] height = new int[m];
        int maxArea = 0;

        for (int i = 0; i < n; i++) {
            // Build histogram heights for the current row
            for (int j = 0; j < m; j++) {
                if (mat[i][j] == 1) {
                    height[j]++;
                } else {
                    height[j] = 0;
                }
            }

            // Since columns can be swapped, sort heights.
            // Any columns with sufficient height can be placed together.
            int[] sorted = height.clone();
            java.util.Arrays.sort(sorted);

            for (int j = 0; j < m; j++) {
                int width = m - j;
                maxArea = Math.max(maxArea, sorted[j] * width);
            }
        }

        return maxArea;
    }
}
